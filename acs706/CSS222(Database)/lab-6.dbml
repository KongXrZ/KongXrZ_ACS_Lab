Table instructors {
  instructor_id int [pk, increment]
  name varchar(100) [not null]
}

Table clubs {
  club_id int [pk, increment]
  name varchar(100) [not null]
  advisor_id int [not null]
}

Table events {
  event_id int [pk, increment]
  club_id int [not null]
  name varchar(150) [not null]
}

Table students {
  student_id int [pk, increment]
  name varchar(100) [not null]
}

Table registrations {
  student_id int [not null]
  event_id int [not null]
  registered_at timestamp [not null]
  status varchar(20) [not null, note: 'pending, approved, rejected']

  indexes {
    (student_id, event_id) [pk]
  }
}

Ref: clubs.advisor_id > instructors.instructor_id
Ref: events.club_id > clubs.club_id
Ref: registrations.student_id > students.student_id
Ref: registrations.event_id > events.event_id